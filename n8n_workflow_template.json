        "type": "n8n-nodes-base.openAi",
        "typeVersion": 1,
        "position": [650, 200]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://your-jira-instance/rest/api/2/issue/{{ $('Jira Webhook (In Testing)').item.json[\"body\"][\"issue\"][\"key\"] }}/comment",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "body",
                "value": "={{ $json[\"text\"] }}"
              }
            ]
          }
        },
        "id": "fa2b39ad-2bf0-4fb2-bd74-4b5314a51139",
        "name": "Add Checklist to Jira",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [850, 200]
      },
      {
        "parameters": {
          "model": "gpt-4o",
          "prompt": "=/Generate structured manual test cases in valid JSON array format (UI, API, E2E) for Jira Key {{ $('Jira Webhook (In Testing)').item.json[\"body\"][\"issue\"][\"key\"] }}.\nEach object MUST have fields:\n- id: string (e.g. \"{{ $('Jira Webhook (In Testing)').item.json[\"body\"][\"issue\"][\"key\"] }}-1162\")\n- qaseCaseId: integer (numeric ID in Qase)\n- title: string\n- type: \"UI\", \"API\", or \"E2E\"\n- steps: array of objects with \"action\" and \"expected\"\n\nBase TS:\n{{ $('LLM: Normalize TS').item.json[\"text\"] }}"
        },
        "id": "9742da8c-5721-4f11-9a74-b52e078f4a13",
        "name": "LLM: Generate TCs (JSON)",
        "type": "n8n-nodes-base.openAi",
        "typeVersion": 1,
        "position": [650, 400]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "https://api.qase.io/v1/case/ROMEO?limit=100",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth"
        },
        "id": "4e7a83fa-cf7d-419b-a37a-e490e58c0bdf",
        "name": "Fetch Existing Qase Manual TCs",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [850, 400]
      },
      {
        "parameters": {
          "model": "gpt-4o",
          "prompt": "=/Compare generated test cases:\n{{ $('LLM: Generate TCs (JSON)').item.json[\"text\"] }}\n\nwith existing Qase cases:\n{{ $json[\"result\"][\"entities\"] }}\n\nDeduplicate and ensure formatting matches requirements. Return JSON array of clean test cases."
        },
        "id": "b3e94a82-124e-4f1b-ab5c-9cb304a0e1c2",
        "name": "LLM: Deduplicate & Format",
        "type": "n8n-nodes-base.openAi",
        "typeVersion": 1,
        "position": [1050, 400]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:5000/agent/trigger-codegen",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"task\": \"Сгенерируй Android-автотесты по ручным кейсам\",\n  \"platform\": \"android\",\n  \"jiraKey\": \"{{ $('Jira Webhook (In Testing)').item.json[\"body\"][\"issue\"][\"key\"] }}\",\n  \"apply\": true,\n  \"testCases\": {{ $json[\"text\"] }}\n}"
        },
        "id": "e92c42ab-7bf0-410a-8bf8-d3e904ab724b",
