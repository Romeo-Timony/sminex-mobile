      "typeVersion": 4,
      "position": [850, 200]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "=/Generate structured manual test cases in JSON format (UI, API, E2E) with Title, Type, Preconditions, Steps, and Expected Results based on this normalized TS:\n{{ $('LLM: Normalize TS').item.json[\"text\"] }}"
