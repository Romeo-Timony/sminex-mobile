        },
        "id": "e96c56db-83b3-46c9-b3a5-2965377f7229",
        "name": "LLM: Normalize TS",
        "type": "n8n-nodes-base.openAi",
        "typeVersion": 1,
        "position": [450, 300]
      },
      {
        "parameters": {
          "model": "gpt-4o",
          "prompt": "=/Generate a QA checklist (positive, negative, integration, UI/Mobile) for this normalized TS:\n{{ $json[\"text\"] }}"
