# Appium server and Android device
APPIUM_SERVER=http://127.0.0.1:4723
PLATFORM_NAME=Android
DEVICE_NAME=Android Emulator
AUTOMATION_NAME=UiAutomator2
# UDID=emulator-5554

# installed: run already installed application; apk: install APP_PATH first.
APP_MODE=installed
APP_PACKAGE=com.sminex.sminex_app
APP_ACTIVITY=com.sminex.sminex_app.MainActivity
# APP_PATH=D:\\path\\to\\app-dev.apk
EXPLICIT_WAIT_SECONDS=20

# Dedicated test account. Never use a personal account in automation.
TEST_PHONE=+79097922999
# Enable only on a test/debug build that visibly exposes otpCodeDebug=####.
DEBUG_OTP_ENABLED=true
# Defaults to the Retrofit OTP endpoint. Override only for another app version.
# MOCK_OTP_REQUEST_PATH=/api/v1/auth/send

# Backend mode for UI tests. The app mock/debug flavor must consume
# APP_API_BASE_URL; this test repository cannot change the app endpoint itself.
BACKEND_MODE=live
# WIREMOCK_ADMIN_URL=http://127.0.0.1:8080
# APP_API_BASE_URL=http://10.0.2.2:8080
# WireMock recorder upstream (used by docker-compose.record.yml).
# WIREMOCK_PROXY_TARGET=https://apigateway-sc-dev.sminex.digital

# API test environment (required only for pytest -m api)
# API_BASE_URL=https://test-api.example.com
# OTP_REQUEST_PATH=/api/v1/auth/send
# OTP_REQUEST_SUCCESS_STATUS=200
# OTP_REQUEST_INVALID_STATUS=400

# Qase TestOps: keep the real token only in the ignored .env file.
# QASE_API_TOKEN=your_qase_api_token
QASE_PROJECT_CODE=ROMEO
# IDs are resolved once from the Qase suite tree and stored only in .env.
# QASE_MANUAL_UI_SUITE_ID=1
# QASE_MANUAL_API_SUITE_ID=2
# QASE_MANUAL_E2E_SUITE_ID=3
# Automation coverage is recorded on the original manual case via custom fields;
# a separate Qase automation suite is intentionally not used.
# QASE_FIELD_AUTOMATION_COVERAGE=1
# QASE_FIELD_AUTOMATION_TYPE=2
# QASE_FIELD_AUTOMATION_CODE_PATH=3
# QASE_FIELD_AUTOMATION_TEST_ID=4
# QASE_FIELD_AUTOMATION_NOTE=5
